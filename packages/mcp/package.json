  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "happy-dom": "^20.0.0",
    "zod": "^4.5.4"
  },
  "peerDependencies": {
    "@aeon-framework/core": "^0.1.0"
  },
  "devDependencies": {
    "@aeon-framework/cli": "^0.1.0",
    "@aeon-framework/core": "^0.1.0"
  }
