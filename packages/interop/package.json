{
  "name": "@aeon-framework/interop",
  "version": "0.1.1",
  "description": "Embed Aeon components inside another framework's tree, or read Aeon signals from it. Aeon mounts to a real DOM node it fully owns, so this is a plain escape hatch, not a virtual-DOM reconciliation bridge.",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "exports": {
    "./react": {
      "types": "./src/react.d.ts",
      "default": "./src/react.js"
    },
    "./vue": {
      "types": "./src/vue.d.ts",
      "default": "./src/vue.js"
    },
    "./vanilla": {
      "types": "./src/vanilla.d.ts",
      "default": "./src/vanilla.js"
    }
  },
  "peerDependencies": {
    "@aeon-framework/core": "^0.1.0",
    "react": ">=17",
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "dependencies": {
    "@aeon-framework/core": "^0.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src"
  ]
}
